<UserControl x:Class="Modele1.UserControls.PronomUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Modele1.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
           Grid.Column="0"
           Grid.ColumnSpan="2"
           Text="Pronom DROID_SignatureFile.xml"
           Margin="0,0,0,4" />

        <TextBox x:Name="FileTextBox"
         Grid.Row="1"
         Grid.Column="0"
         Margin="0,0,8,12" />

        <Button Grid.Row="1"
        Grid.Column="1"
        Content="..."
        Tag="File"
        Click="SelectFile_Click"
        Margin="0,0,0,12" />

        <TextBlock Grid.Row="2"
           Grid.Column="0"
           Grid.ColumnSpan="2"
           Text="Pronom container-signature.xml"
           Margin="0,0,0,4" />

        <TextBox x:Name="ContainerTextBox"
         Grid.Row="3"
         Grid.Column="0"
         Margin="0,0,8,12" />

        <Button Grid.Row="3"
        Grid.Column="1"
        Content="..."
        Tag="Container"
        Click="SelectFile_Click"
        Margin="0,0,0,12" />

        <Button Grid.Row="4"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Content="Import"
        Click="Import_Click"
        HorizontalAlignment="Right"
        Width="120" />
    </Grid>
</UserControl>
