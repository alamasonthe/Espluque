<UserControl x:Class="WindowsInstaller.MsiDbViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WindowsInstaller"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="TableList"
                 Grid.Column="0"
                 Margin="5"
                 Style="{DynamicResource Thesaurus.RelationListBox}"
                 SelectionChanged="TableList_SelectionChanged"/>

        <GridSplitter Grid.Column="1"
                      Width="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource App.Border}"/>

        <RichTextBox x:Name="TableRichTextBox"
             Grid.Column="2"
             IsReadOnly="True"
             IsDocumentEnabled="False"
             BorderThickness="0"
             Background="{DynamicResource App.Background}"
             Foreground="{DynamicResource App.Text}"
             SelectionBrush="{DynamicResource App.Selection}"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Disabled"
             Padding="0"
             FontFamily="Segoe UI"
             FontSize="13" />

    </Grid>
</UserControl>