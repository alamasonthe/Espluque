<UserControl x:Class="Pronom.UserControls.MaintenanceUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Pronom.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- DROID signature file -->
        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="20"
                Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="6">

            <Grid VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="DROID Signature File"
                           Style="{DynamicResource App.StandardTextBlock}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1"
                           Text="File containing the signatures used by PRONOM to identify file formats."
                           Foreground="{DynamicResource App.TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="FileTextBox"
                             Grid.Column="0"
                             Style="{StaticResource App.StandardTextBox}"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0"/>

                    <Button Grid.Column="1"
                            Width="90"
                            Content="Browse"
                            Tag="File"
                            Click="SelectFile_Click"/>

                </Grid>

            </Grid>

        </Border>

        <!-- Container signature file -->
        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Padding="20"
                Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="6">

            <Grid VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Container Signature File"
                           Style="{DynamicResource App.StandardTextBlock}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1"
                           Text="File containing the signatures used to identify formats embedded in containers."
                           Foreground="{DynamicResource App.TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ContainerTextBox"
                             Grid.Column="0"
                             Style="{StaticResource App.StandardTextBox}"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0"/>

                    <Button Grid.Column="1"
                            Width="90"
                            Content="Browse"
                            Tag="Container"
                            Click="SelectFile_Click"/>

                </Grid>

            </Grid>

        </Border>

        <!-- Actions -->
        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,1,0,0">

            <Button Content="Import"
                    Click="Import_Click"
                    HorizontalAlignment="Right"
                    Width="120"/>

        </Border>

    </Grid>

</UserControl>