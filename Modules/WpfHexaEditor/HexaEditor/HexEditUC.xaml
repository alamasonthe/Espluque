<UserControl x:Class="HexaEditor.HexEditUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HexaEditor"
             xmlns:hex="clr-namespace:WpfHexaEditor;assembly=WPFHexaEditor"
             xmlns:theme="clr-namespace:Espluque.Theming;assembly=Espluque.Theming"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Background="{DynamicResource App.Background}">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Stretch">

            <hex:HexEditor x:Name="HexEditor"
                           BytePerLine="16"
                           FontFamily="Consolas"
                           FontSize="13"
                           Background="{DynamicResource App.Background}" 
                           Foreground="{DynamicResource App.Text}"
                           ReadOnlyMode="True"/>

        </Border>
    </Grid>
</UserControl>
