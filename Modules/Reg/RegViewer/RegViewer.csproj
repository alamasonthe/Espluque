<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(ContractsProjectPath)" />
		<ProjectReference Include="$(ModuleCommonsProjectPath)" />
		<ProjectReference Include="$(ThemingProjectPath)" />
		<ProjectReference Include="$(UtilProjectPath)" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="RegEdit.xaml.cs">
			<SubType>Code</SubType>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="module.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Target Name="CopyModuleToHost" AfterTargets="Build">
		<PropertyGroup>
			<HostModuleDirectory>$(ModuleOutputDirectory)$(AssemblyName)\</HostModuleDirectory>
		</PropertyGroup>

		<MakeDir Directories="$(HostModuleDirectory)" />

		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HostModuleDirectory)" />
		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(HostModuleDirectory)" Condition="'$(Configuration)' == 'Debug'" />
		<Copy SourceFiles="$(ProjectDir)module.json" DestinationFolder="$(HostModuleDirectory)" />

		<Copy SourceFiles="$(TargetDir)Microsoft.Extensions.Configuration.dll" DestinationFolder="$(HostModuleDirectory)" />
		<Copy SourceFiles="$(TargetDir)Microsoft.Extensions.Configuration.Abstractions.dll" DestinationFolder="$(HostModuleDirectory)" />
		<Copy SourceFiles="$(TargetDir)Microsoft.Extensions.Configuration.Ini.dll" DestinationFolder="$(HostModuleDirectory)" />
		<Copy SourceFiles="$(TargetDir)Microsoft.Extensions.Configuration.FileExtensions.dll" DestinationFolder="$(HostModuleDirectory)" />
		<Copy SourceFiles="$(TargetDir)Microsoft.Extensions.FileProviders.Abstractions.dll" DestinationFolder="$(HostModuleDirectory)" />
		<Copy SourceFiles="$(TargetDir)Microsoft.Extensions.Primitives.dll" DestinationFolder="$(HostModuleDirectory)" />
		<Copy SourceFiles="$(TargetDir)Microsoft.Extensions.FileProviders.Physical.dll" DestinationFolder="$(HostModuleDirectory)" />
		<Copy SourceFiles="$(TargetDir)Microsoft.Extensions.FileSystemGlobbing.dll" DestinationFolder="$(HostModuleDirectory)" />
	</Target>

</Project>