<UserControl x:Class="Espluquer.UserControls.Views.LogUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Espluquer.UserControls.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>

        <Style x:Key="LogLevelSlider"
               TargetType="Slider">

            <Setter Property="Height"
                    Value="20"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>

                            <Track x:Name="PART_Track">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="{DynamicResource App.Accent}"
                                                  BorderThickness="0"
                                                  Height="4"
                                                  VerticalAlignment="Center"/>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="{DynamicResource App.TextMuted}"
                                                  BorderThickness="0"
                                                  Height="4"
                                                  VerticalAlignment="Center"/>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="14"
                                           Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource App.Accent}"
                                                         Stroke="{DynamicResource App.Surface}"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                            </Track>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="LogTextBox"
             Grid.Row="0"
             Style="{StaticResource App.Controls.TextBox.MultilineNoWrap}"
             FontFamily="Consolas"
             IsReadOnly="True"
             IsUndoEnabled="False"/>

        <!-- Bouton central entre le log et les contrôles -->
        <Button x:Name="LogFilterToggleButton"
            Grid.Row="1"
            Width="48"
            Height="8"
            Margin="0,4"
            HorizontalAlignment="Center"
            Background="{DynamicResource App.Accent}"
            BorderThickness="0"
            Cursor="Hand"
                
            Click="LogFilterToggleButton_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="2"/>
                </ControlTemplate>
            </Button.Template>

        </Button>

        <Grid x:Name="LogFilterPanel" Grid.Row="2" Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Slider x:Name="LogLevelSlider"
                Grid.Row="0"
                Margin="0,8,0,0"
                Style="{StaticResource LogLevelSlider}"
                Minimum="1"
                Maximum="5"
                Value="2"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                IsMoveToPointEnabled="True"/>

            <Grid Grid.Row="1"
              Margin="7,2,7,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                       Text="Debug"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource App.TextMuted}"/>

                <TextBlock Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Text="Information"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource App.TextMuted}"/>

                <TextBlock Grid.Column="3"
                       Grid.ColumnSpan="2"
                       Text="Warning"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource App.TextMuted}"/>

                <TextBlock Grid.Column="5"
                       Grid.ColumnSpan="2"
                       Text="Error"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource App.TextMuted}"/>

                <TextBlock Grid.Column="7"
                       Text="Critical"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource App.TextMuted}"/>

            </Grid>

        </Grid>

    </Grid>
    
    
</UserControl>