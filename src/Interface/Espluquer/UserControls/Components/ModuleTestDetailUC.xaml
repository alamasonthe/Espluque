<UserControl x:Class="Espluquer.UserControls.Components.ModuleTestDetailUC"
             x:Name="ModuleDetailRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModuleDiagnosticStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource App.Background}">

        <StackPanel Margin="8">

            <!-- Module -->

            <Expander Style="{StaticResource App.SectionExpander}" IsExpanded="True" Margin="0,0,0,8">

                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Ellipse Width="12" Height="12" Style="{StaticResource ModuleStatusEllipseStyle}" />

                        <TextBlock Margin="8,0,0,0"
                           Style="{StaticResource App.StandardSubtitleTextBlock}"
                           Foreground="{DynamicResource App.TextInverse}"
                           VerticalAlignment="Center"
                           Text="{Binding ModuleDiagnostic.Name, ElementName=ModuleDetailRoot}" />

                    </StackPanel>
                    </Expander.Header>

                <Border Background="{DynamicResource App.Background}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1"
                        Padding="12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource App.StandardTextBlock}"
                                   Grid.Column="0"
                                   Margin="0,4,8,4"
                                   VerticalAlignment="Center"
                                   Text="Version" />

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="0,2"
                                 IsReadOnly="True"
                                 Text="{Binding ModuleDiagnostic.Version, ElementName=ModuleDetailRoot}" />

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource App.StandardTextBlock}"
                                   Grid.Column="0"
                                   Margin="0,4,8,4"
                                   VerticalAlignment="Center"
                                   Text="Assembly" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,2"
                                 IsReadOnly="True"
                                 Text="{Binding ModuleDiagnostic.Assembly,
                                                ElementName=ModuleDetailRoot}" />

                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource App.StandardTextBlock}"
                                   Grid.Column="0"
                                   Margin="0,4,8,4"
                                   VerticalAlignment="Center"
                                   Text="File path" />

                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,2"
                                 IsReadOnly="True"
                                 Text="{Binding ModuleDiagnostic.FilePath,
                                                ElementName=ModuleDetailRoot}" />

                        <TextBox Grid.Row="3"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             Margin="0,8,0,0"
                             MinHeight="60"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             Text="{Binding ModuleDiagnostic.ErrorDescription,
                        ElementName=ModuleDetailRoot}">

                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text"
                         Value="">
                                            <Setter Property="Visibility"
                            Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>

                        </TextBox>
                        
                    </Grid>

                </Border>

            </Expander>

            <!-- JSON -->

            <Expander Header="JSON"
                      Style="{StaticResource App.SectionExpander}"
                      IsExpanded="False"
                      Margin="0,0,0,8">

                <Border Background="{DynamicResource App.Background}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1"
                        Padding="8">

                    <TextBox Style="{StaticResource App.TextEditorTextBox}"
                             Text="{Binding ModuleDiagnostic.Json, ElementName=ModuleDetailRoot}" />

                </Border>

            </Expander>

            <!-- Contributions -->

            <ItemsControl ItemsSource="{Binding ModuleDiagnostic.Contributions, ElementName=ModuleDetailRoot}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Expander Margin="0,0,0,8"
                                  Style="{StaticResource App.SectionExpander}"
                                  IsExpanded="False">

                            <Expander.Header>
                                <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Loaded="ContributionHeader_Loaded" />
                            </Expander.Header>

                            <Border Background="{DynamicResource App.Background}"
                                    BorderBrush="{DynamicResource App.Border}"
                                    BorderThickness="1"
                                    Padding="12">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Style="{StaticResource App.StandardTextBlock}"
                                               Grid.Column="0"
                                               Margin="0,4,8,4"
                                               VerticalAlignment="Center"
                                               Text="Label" />

                                    <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             Margin="0,2"
                                             IsReadOnly="True"
                                             Text="{Binding Label}" />

                                    <TextBlock Grid.Row="1"
                                               Style="{StaticResource App.StandardTextBlock}"
                                               Grid.Column="0"
                                               Margin="0,4,8,4"
                                               VerticalAlignment="Center"
                                               Text="Interface type" />

                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Margin="0,2"
                                             IsReadOnly="True"
                                             Text="{Binding InterfaceType}" />

                                    <TextBlock Grid.Row="2"
                                               Style="{StaticResource App.StandardTextBlock}"
                                               Grid.Column="0"
                                               Margin="0,4,8,4"
                                               VerticalAlignment="Center"
                                               Text="Class name" />

                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Margin="0,2"
                                             IsReadOnly="True"
                                             Text="{Binding ClassName}" />

                                    <TextBlock Grid.Row="3"
                                               Style="{StaticResource App.StandardTextBlock}"
                                               Grid.Column="0"
                                               Margin="0,4,8,4"
                                               VerticalAlignment="Center"
                                               Text="Active" />

                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             Margin="0,2"
                                             IsReadOnly="True"
                                             Text="{Binding Active}" />

                                    <TextBlock Grid.Row="4"
                                               Style="{StaticResource App.StandardTextBlock}"
                                               Grid.Column="0"
                                               Margin="0,4,8,4"
                                               VerticalAlignment="Center"
                                               Text="Health check" />

                                    <TextBox Grid.Row="4"
                                             Grid.Column="1"
                                             Margin="0,2"
                                             IsReadOnly="True"
                                             Text="{Binding ContributionHealthCheck}" />

                                    <TextBlock Grid.Row="5"
                                               Style="{StaticResource App.StandardTextBlock}"
                                               Grid.Column="0"
                                               Margin="0,4,8,4"
                                               VerticalAlignment="Top"
                                               Text="Tags" />

                                    <ItemsControl Grid.Row="5"
                                                  Grid.Column="1"
                                                  Margin="0,2"
                                                  ItemsSource="{Binding Tags}">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Margin="0,0,0,4"
                                                     IsReadOnly="True"
                                                     Text="{Binding Path=., Mode=OneWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                    <TextBox Grid.Row="6"
                                         Grid.Column="0"
                                         Grid.ColumnSpan="2"
                                         Margin="0,8,0,0"
                                         MinHeight="60"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         IsReadOnly="True"
                                         Text="{Binding ErrorDescription}">

                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Text"
                         Value="">
                                                        <Setter Property="Visibility"
                            Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>

                                    </TextBox>

                                </Grid>

                            </Border>

                        </Expander>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </ScrollViewer>

</UserControl>