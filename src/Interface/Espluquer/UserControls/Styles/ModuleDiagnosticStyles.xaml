<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:enums="clr-namespace:Espluque.Contracts.Enums;assembly=Espluque.Contracts">

    <Style x:Key="ModuleContributionIconStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily" Value="{DynamicResource FluentIcons}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />

    </Style>

    <Style x:Key="ModuleStatusEllipseStyle"
           TargetType="Ellipse">

        <Setter Property="HorizontalAlignment"
                Value="Center" />

        <Setter Property="VerticalAlignment"
                Value="Center" />

        <Setter Property="Fill"
                Value="Transparent" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding ModuleDiagnostic.ModuleHealthCheck,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Value="{x:Static enums:ModuleHealthCheckEnum.Running}">

                <Setter Property="Fill"
                        Value="{DynamicResource App.StatusWarning}" />

            </DataTrigger>

            <DataTrigger Binding="{Binding ModuleDiagnostic.ModuleHealthCheck,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Value="{x:Static enums:ModuleHealthCheckEnum.Success}">

                <Setter Property="Fill"
                        Value="{DynamicResource App.StatusSuccess}" />

            </DataTrigger>

            <DataTrigger Binding="{Binding ModuleDiagnostic.ModuleHealthCheck,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Value="{x:Static enums:ModuleHealthCheckEnum.Error}">

                <Setter Property="Fill"
                        Value="{DynamicResource App.StatusError}" />

            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>