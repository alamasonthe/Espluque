<UserControl x:Class="Espluquer.UserControls.Components.ModuleDiagnosticUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Espluquer.UserControls.Components"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="ModuleListBox"
                 Grid.Column="0"
                 Background="{DynamicResource App.Background}"
                 BorderThickness="0"
                 Foreground="{DynamicResource App.Text}"
                 HorizontalContentAlignment="Stretch"
                 Grid.IsSharedSizeScope="True">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:ModuleTestLineUC ModuleDiagnostic="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <GridSplitter Grid.Column="1"
                      Width="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource App.Border}" />

        <ContentControl x:Name="ModuleDetailsHost"
                        Grid.Column="2" />
    </Grid>

</UserControl>