<UserControl x:Class="Espluquer.UserControls.Components.AboutUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="420">

    <Grid Background="{DynamicResource App.Background}">
        <Border MaxWidth="720"
                Margin="32"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ApplicationLogo"
                       Grid.Column="0"
                       Width="112"
                       Height="112"
                       Margin="0,0,32,0"
                       VerticalAlignment="Top"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True" />

                <RichTextBox Grid.Column="1"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource App.Text}"
                             IsReadOnly="True"
                             IsDocumentEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled">

                    <FlowDocument PagePadding="0"
                                  FontFamily="Segoe UI"
                                  FontSize="14"
                                  Foreground="{DynamicResource App.Text}">

                        <Paragraph Margin="0,0,0,2"
                                   FontSize="30"
                                   FontWeight="SemiBold">
                            Espluque
                        </Paragraph>

                        <Paragraph Margin="0,0,0,24"
                                   Foreground="{DynamicResource App.TextMuted}">
                            <Run x:Name="VersionRun"
                                 Text="Version" />
                        </Paragraph>

                        <Paragraph Margin="0,0,0,20">
                            Modular file analysis application based on a
                            thesaurus-driven execution engine.
                        </Paragraph>

                        <Paragraph Margin="0,0,0,14">
                            <Bold>License</Bold>
                            <LineBreak />
                            Released under the MIT License.
                            <LineBreak />
                            © 2026 François Guéchoum
                        </Paragraph>

                        <Paragraph Margin="0">
                            <Bold>Source code</Bold>
                            <LineBreak />

                            <Hyperlink x:Name="RepositoryHyperlink"
                                       Foreground="{DynamicResource App.Text}"
                                       TextDecorations="Underline"
                                       Cursor="Hand"
                                       RequestNavigate="RepositoryHyperlink_RequestNavigate" />
                        </Paragraph>

                    </FlowDocument>
                </RichTextBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>