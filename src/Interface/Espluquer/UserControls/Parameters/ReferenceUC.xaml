<UserControl x:Class="Espluquer.UserControls.Parameters.ReferenceUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760"
             MinHeight="450"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <UserControl.Resources>

        <Style x:Key="StatLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource App.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatValueStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource App.Text}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource App.Background}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- References -->
        <Border Grid.Column="0"
                Padding="8"
                Background="{DynamicResource App.Background}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="5">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox x:Name="ReferencesListBox"
                         Grid.Row="0"
                         ItemsSource="{Binding References}"
                         SelectionChanged="ReferencesListBox_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource App.Text}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1">

                    <Button x:Name="AddReferenceButton"
                        Style="{StaticResource Thesaurus.AddListItemButton}"
                        Content="&#xF109;"
                        Click="AddReferenceButton_Click" />

                    <TextBox x:Name="NewReferenceTextBox"
                         Style="{StaticResource App.StandardTextBox}"
                         Visibility="Collapsed"
                         KeyDown="NewReferenceTextBox_KeyDown"
                         LostKeyboardFocus="NewReferenceTextBox_LostKeyboardFocus" />
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{DynamicResource App.Border}"
              ShowsPreview="True"
              ResizeDirection="Columns" />
        
        <!-- Selected reference -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                       Margin="12,12,12,0">

            <StackPanel>

                <!-- Rename / delete -->
                <Grid x:Name="ReferenceHeaderPanel">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ReferenceNameTextBox"
                         Grid.Column="0"
                         Height="36"
                         Style="{StaticResource App.StandardTextBox}"
                         FontSize="16"
                         FontWeight="SemiBold" />

                    <Button x:Name="DeleteReferenceButton"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        Style="{StaticResource App.FluentButtonClose}"
                        FontSize="20"
                        Content="&#xF34C;" />

                </Grid>

                <!-- Statistics card -->
                <Border Margin="0,12,0,12"
                    Padding="18"
                    Background="{DynamicResource App.Surface}"
                    BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="5">

                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Terms"
                           Style="{StaticResource StatLabelStyle}" />

                                <TextBlock x:Name="ReferenceTermCountText"
                           Text="0"
                           Style="{StaticResource StatValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Concepts"
                           Style="{StaticResource StatLabelStyle}" />

                                <TextBlock x:Name="ReferenceConceptCountText"
                           Text="0"
                           Style="{StaticResource StatValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Preferred terms"
                           Style="{StaticResource StatLabelStyle}" />

                                <TextBlock x:Name="PreferredTermCountText"
                           Text="0"
                           Style="{StaticResource StatValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Without alternative"
                           Style="{StaticResource StatLabelStyle}" />

                                <TextBlock x:Name="ConceptWithoutAlternativeCountText"
                           Text="0"
                           Style="{StaticResource StatValueStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="ReferenceWarningBorder"
                            Margin="0,16,0,0"
                            Padding="12,9"
                            Background="{DynamicResource App.Background}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="4">

                            <TextBlock x:Name="ReferenceWarningText"
                       Foreground="{DynamicResource App.Text}"
                       TextWrapping="Wrap" />
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Terms table -->
                <Border Background="{DynamicResource App.Surface}"
                    BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="5">

                    <StackPanel>

                        <Grid Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                               Text="Term"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextMuted}" />

                            <TextBlock Grid.Column="1"
                               Text="Status"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextMuted}" />

                            <TextBlock Grid.Column="2"
                               Text="Preferred term"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextMuted}" />

                            <TextBlock Grid.Column="3"
                               Text="Concept Term Count"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextMuted}" />

                        </Grid>

                        <Border Height="1" Background="{DynamicResource App.Border}" />

                        <ItemsControl x:Name="ReferenceTermsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <StackPanel>

                                        <Grid Margin="12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                               Text="{Binding Term}"
                                               Foreground="{DynamicResource App.Text}"
                                               TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Foreground="{DynamicResource App.Text}"
                                               TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="2"
                                               Text="{Binding PreferredTerm}"
                                               Foreground="{DynamicResource App.Text}"
                                               TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="3"
                                               Text="{Binding ConceptTermCount}"
                                               Foreground="{DynamicResource App.Text}"
                                               TextTrimming="CharacterEllipsis" />

                                        </Grid>

                                        <Border Height="1"
                                Background="{DynamicResource App.Border}" />

                                    </StackPanel>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>