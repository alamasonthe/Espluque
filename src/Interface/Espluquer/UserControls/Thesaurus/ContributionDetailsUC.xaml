<UserControl x:Class="Espluquer.UserControls.Thesaurus.ContributionDetailsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Espluquer.UserControls.Thesaurus"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ModuleDiagnosticStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            VerticalAlignment="Center">
            <TextBlock x:Name="ConceptHeaderIdText"
           Style="{StaticResource App.StandardTitleTextBlock}"
           Text="{Binding Id}" />

            <TextBlock x:Name="ConceptHeaderSeparatorText"
           Style="{StaticResource App.MutedTitleTextBlock}"
           Text=" - " />

            <TextBlock x:Name="ConceptHeaderTermText"
           Style="{StaticResource App.StandardTitleTextBlock}"
           Text="{Binding Term}" />
        </StackPanel>

        <ItemsControl x:Name="ContributionsList"
              Grid.Row="1"
              Margin="0,12,0,0">

            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Expander Margin="0,0,0,8"
                      Style="{StaticResource App.SectionExpander}"
                      IsExpanded="False">

                        <Expander.Header>
                            <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Loaded="ContributionHeader_Loaded" />
                        </Expander.Header>

                        <Border Background="{DynamicResource App.Background}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            Padding="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,4,8,4"
                                   Style="{StaticResource App.StandardTextBlock}"
                                   Text="Interface type" />

                                <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="0,2"
                                 IsReadOnly="True"
                                 Text="{Binding InterfaceType}" />

                                <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,4,8,4"
                                   Style="{StaticResource App.StandardTextBlock}"
                                   Text="Class name" />

                                <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,2"
                                 IsReadOnly="True"
                                 Text="{Binding ClassName}" />

                                <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,4,8,4"
                                   Style="{StaticResource App.StandardTextBlock}"
                                   Text="Module" />

                                <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,2"
                                 IsReadOnly="True"
                                 Text="{Binding ModuleName}" />
                            </Grid>

                        </Border>

                    </Expander>

                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </Grid>
</UserControl>
