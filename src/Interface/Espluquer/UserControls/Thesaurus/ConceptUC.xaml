<uc:RefreshableUserControl x:Class="Espluquer.UserControls.Thesaurus.ConceptUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uc="clr-namespace:Espluquer.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <TreeView x:Name="ConceptTreeView"
              Grid.Column="0"
              Style="{DynamicResource App.Controls.TreeView}"
              ItemContainerStyle="{StaticResource App.Controls.TreeViewItem}"
              SelectedItemChanged="ConceptTreeView_SelectedItemChanged">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBox Style="{StaticResource App.StandardTextBox}"
                         Text="{Binding Name, Mode=OneWay}"
                         IsReadOnly="True"
                         Focusable="False"
                         MouseDoubleClick="ConceptNameTextBox_EnterEditMode"
                         ContextMenuOpening="ConceptTreeView_ContextMenuOpening"
                         PreviewMouseLeftButtonDown="ConceptSaveDragStartPoint"
                         PreviewMouseMove="ConceptDragStart"
                         AllowDrop="True"
                         PreviewDragOver="ConceptAllowDrop"
                         PreviewDrop="ConceptDrop">
                        <TextBox.ContextMenu>
                            <ContextMenu />
                        </TextBox.ContextMenu>
                    </TextBox>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Column="1"
                  Width="3"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource App.Border}" />

        <ContentControl x:Name="ConceptDetailsHost"
                    Grid.Column="2" />

        <GridSplitter Grid.Column="3"
                  Width="3"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource App.Border}" />

        <ContentControl x:Name="ConceptGraphHost"
                    Grid.Column="4" />
    </Grid>

</uc:RefreshableUserControl>
