<uc:RefreshableUserControl x:Class="Espluquer.UserControls.ResultModeling.ResultModelsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Espluquer.UserControls.ResultModeling"
             xmlns:uc="clr-namespace:Espluquer.UserControls"
             mc:Ignorable="d"
             MinWidth="760"
             MinHeight="450"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Background="{DynamicResource App.Background}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Result models -->
        <Border Grid.Column="0"
            Padding="8"
            Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="5">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox x:Name="ResultModelsListBox"
                 Grid.Row="0"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}"
                               Foreground="{DynamicResource App.Text}"
                               TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1">

                    <Button x:Name="AddResultModelButton"
                        Style="{StaticResource Thesaurus.AddListItemButton}"
                        Content="&#xF109;"
                        Click="AddResultModelButton_Click" />

                    <TextBox x:Name="NewResultModelTextBox"
                         Style="{StaticResource App.StandardTextBox}"
                         Visibility="Collapsed"
                         KeyDown="NewResultModelTextBox_KeyDown"
                         LostKeyboardFocus="NewResultModelTextBox_LostKeyboardFocus" />
                </Grid>
            </Grid>
        </Border>
        
        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource App.Border}"
                      ShowsPreview="True"
                      ResizeDirection="Columns" />

        <!-- Selected result model -->
        <Grid x:Name="ResultModelContent" Grid.Column="2" Margin="12">

            <Grid DataContext="{Binding SelectedItem, ElementName=ResultModelsListBox}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Name / delete -->
                <Grid Grid.Row="0" Margin="12,12,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ResultModelNameTextBox"
                         Grid.Column="0"
                         Height="36"
                         Text="{Binding Name, Mode=TwoWay}"
                         Style="{StaticResource App.StandardTextBox}"
                         FontSize="16"
                         FontWeight="SemiBold" />

                    <Button x:Name="DeleteResultModelButton"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        Style="{StaticResource App.FluentButtonClose}"
                        FontSize="20"
                        Content="&#xF34C;"
                        Click="DeleteResultModelButton_Click" />
                </Grid>

                <!-- Thesaurus tag -->
                <StackPanel Grid.Row="1" Margin="12,12,12,0">
                    <TextBlock Text="Thesaurus tag"
                            Margin="0,0,0,4"
                            Foreground="{DynamicResource App.TextMuted}"
                            FontWeight="SemiBold" />

                    <TextBox x:Name="ThesaurusTagTextBox"
                         Text="{Binding ThesaurusTag, Mode=TwoWay}"
                         Style="{StaticResource App.StandardTextBox}"
                         Foreground="{DynamicResource App.Text}" />
                </StackPanel>
                
                <!-- Properties -->
                <Border Grid.Row="2"
                    Margin="12"
                    Background="{DynamicResource App.Surface}"
                    BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="5">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                       Margin="12,10"
                       Text="Properties"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextMuted}" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl ItemsSource="{Binding Properties}"
                              AlternationCount="2147483647">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>

                                            <Grid Margin="12,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0"
                                                     Text="{Binding Mode=OneWay}"
                                                     Tag="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                     Style="{StaticResource App.StandardTextBox}"
                                                     LostKeyboardFocus="PropertyNameTextBox_LostKeyboardFocus" />

                                                <Button Grid.Column="1"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="6,0,0,0"
                                                    Content="▲"
                                                    Tag="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                    Foreground="{DynamicResource App.Text}"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource App.Border}"
                                                    Click="MovePropertyUpButton_Click" />

                                                <Button Grid.Column="2"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="4,0,0,0"
                                                    Content="▼"
                                                    Tag="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                    Foreground="{DynamicResource App.Text}"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource App.Border}"
                                                    Click="MovePropertyDownButton_Click" />

                                                <Button Grid.Column="3"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="4,0,0,0"
                                                    Content="&#xF34C;"
                                                    Tag="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                    Style="{StaticResource App.FluentButtonClose}"
                                                    Click="DeletePropertyButton_Click" />
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource App.Border}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button x:Name="AddPropertyButton"
                            Grid.Row="2"
                            Style="{StaticResource Thesaurus.AddListItemButton}"
                            Content="&#xF109;"
                            Click="AddPropertyButton_Click" />
                    </Grid>
                </Border>
            </Grid>

        </Grid>

    </Grid>
</uc:RefreshableUserControl>