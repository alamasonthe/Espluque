<UserControl x:Class="Espluquer.UserControls.Shell.TextEditUC"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource App.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource App.Background}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,0,0,1"
                Padding="8,6">

            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="WordWrapButton"
                              Style="{StaticResource App.ToggleButton}"
                              IsChecked="{Binding IsWordWrapEnabled, ElementName=Root, Mode=TwoWay}"
                              ToolTip="Saut à la ligne" />

                <ToggleButton x:Name="LineNumbersButton"
                              Style="{StaticResource App.ToggleButton}"
                              IsChecked="{Binding AreLineNumbersVisible, ElementName=Root, Mode=TwoWay}"
                              ToolTip="Numéros de lignes" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="LineNumberBackground"
                        Grid.Column="0"
                        Width="42"
                        Background="{DynamicResource App.Background}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="0,0,1,0"
                        ClipToBounds="True">

                    <Canvas x:Name="LineNumberCanvas"
                            ClipToBounds="True" />
                </Border>

                <TextBox x:Name="TextBoxEditor"
                     Grid.Column="1"
                     Style="{StaticResource App.TextEditorTextBox}"
                     Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly, ElementName=Root}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>