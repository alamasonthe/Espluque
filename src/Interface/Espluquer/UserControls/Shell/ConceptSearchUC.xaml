<UserControl x:Class="Espluquer.UserControls.Shell.ConceptSearchUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Espluquer.UserControls.Shell"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:SearchTermsConverter x:Key="SearchTermsConverter"/>
    </UserControl.Resources>

    <Grid>
        <TextBox x:Name="SearchTextBox"
             Style="{StaticResource App.StandardTextBox}"
             TextChanged="SearchTextBox_TextChanged"/>

        <Popup x:Name="ConceptPopup"
           PlacementTarget="{Binding ElementName=SearchTextBox}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True">

            <Border Width="{Binding ActualWidth, ElementName=SearchTextBox}"
                MaxHeight="350"
                Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1">

                <ListBox x:Name="ConceptList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="ConceptList_SelectionChanged">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Key.Term}"
                                           Foreground="{DynamicResource App.Text}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="1"
                                           Text="{Binding Key.Id}"
                                           Margin="10,0,0,0"
                                           Foreground="{DynamicResource App.TextMuted}"/>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                       Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource SearchTermsConverter}" ConverterParameter="3">
                                            <Binding Path="Key.Terms"/>
                                            <Binding Path="Value"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
