<UserControl x:Class="Espluquer.UserControls.FileViews.AnalysisViewUC"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource App.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,0,0,1"
                Padding="2,6">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                    Style="{DynamicResource App.FluentButton}"
                    Content="&#xF42F;"
                    Click="OpenFileLocationButton_Click" />

                <TextBox Grid.Column="1"
                     x:Name="FilePathTextbox"
                     Style="{DynamicResource App.ReadOnlyTextBox}" />

                <Grid Grid.Column="2"
                      Width="120"
                      Height="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Grid x:Name="AnalysisProgressIcon"
                          Width="30"
                          Height="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"
                          RenderTransformOrigin="0.5,0.5">

                        <Grid.RenderTransform>
                            <RotateTransform x:Name="AnalysisProgressIconRotateTransform"
                             Angle="0" />
                        </Grid.RenderTransform>

                        <TextBlock FontFamily="{DynamicResource FluentIcons}"
                           FontSize="20"
                           Foreground="{DynamicResource App.Text}"
                           Text="&#xF6AB;"
                           Width="30"
                           Height="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           LineHeight="30"
                           LineStackingStrategy="BlockLineHeight"
                           RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="-4" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>

                    <TextBlock x:Name="AnalysisCompletedTextBlock"
                       Text="Analysis completed."
                       Visibility="Collapsed"
                       Foreground="{DynamicResource App.TextMuted}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
                </Grid>
                
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource App.Background}"
                Padding="0">
            <TabControl x:Name="AnalysisTabControl" Style="{DynamicResource App.Controls.ComponentTabControl}" />
        </Border>
    </Grid>

</UserControl>