<UserControl x:Class="Espluquer.UserControls.Modules.ModuleToolsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Espluquer.UserControls.Modules"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource App.Background}">
        <TextBlock x:Name="NoToolsTextBlock"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="{DynamicResource App.TextMuted}"
               FontSize="16"
               IsHitTestVisible="False" />
        
        <TabControl x:Name="ToolsTabControl" Style="{DynamicResource App.Controls.ComponentTabControl}" />
    </Grid>
</UserControl>
