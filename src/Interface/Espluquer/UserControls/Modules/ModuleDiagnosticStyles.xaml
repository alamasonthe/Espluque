<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:crossCutting="clr-namespace:Espluque.Contracts.CrossCutting;assembly=Espluque.Contracts">

    <Style x:Key="ModuleContributionIconStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily" Value="{DynamicResource FluentIcons}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />

        <Setter Property="Foreground"
            Value="{DynamicResource App.TextMuted}" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding HealthCheck}" Value="{x:Static crossCutting:ModuleHealthCheckEnum.Success}">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusSuccess}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding HealthCheck}" Value="{x:Static crossCutting:ModuleHealthCheckEnum.Running}">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusWarning}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding HealthCheck}" Value="{x:Static crossCutting:ModuleHealthCheckEnum.Error}">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusError}" />
            </DataTrigger>

        </Style.Triggers>
    </Style>

    <Style x:Key="ModuleStatusEllipseStyle" TargetType="Ellipse">

        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource App.TextMuted}" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding HealthCheck}"
                     Value="{x:Static crossCutting:ModuleHealthCheckEnum.Success}">
                <Setter Property="Fill" Value="{DynamicResource App.StatusSuccess}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding HealthCheck}"
                     Value="{x:Static crossCutting:ModuleHealthCheckEnum.Running}">
                <Setter Property="Fill" Value="{DynamicResource App.StatusWarning}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding HealthCheck}"
                     Value="{x:Static crossCutting:ModuleHealthCheckEnum.Error}">
                <Setter Property="Fill" Value="{DynamicResource App.StatusError}" />
            </DataTrigger>

        </Style.Triggers>

    </Style>

    <Style x:Key="ModuleHealthRunStyle" TargetType="{x:Type Run}">

        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding HealthCheck}"
                     Value="{x:Static crossCutting:ModuleHealthCheckEnum.Success}">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusSuccess}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding HealthCheck}"
                     Value="{x:Static crossCutting:ModuleHealthCheckEnum.Running}">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusWarning}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding HealthCheck}"
                     Value="{x:Static crossCutting:ModuleHealthCheckEnum.Error}">
                <Setter Property="Foreground" Value="{DynamicResource App.StatusError}" />
            </DataTrigger>

        </Style.Triggers>

    </Style>

</ResourceDictionary>