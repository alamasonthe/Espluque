<UserControl x:Class="Espluquer.UserControls.Modules.ModuleTestLineUC"
             x:Name="ModuleDiagElementRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ModuleDiagnosticStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource App.Background}"
        BorderBrush="{DynamicResource App.Border}"
        BorderThickness="0,0,0,1"
        Padding="8,5">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" SharedSizeGroup="ModuleContributionSummary" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="StatusEllipse"
                 Grid.Column="0"
                 Width="12"
                 Height="12"
                 Style="{StaticResource ModuleStatusEllipseStyle}" />

            <TextBlock x:Name="ModuleNameTextBlock"
               Grid.Column="1"
               Margin="15,0"
               VerticalAlignment="Center"
               Text="{Binding Name}"
               TextTrimming="CharacterEllipsis"/>

            <ContentControl x:Name="ContributionSummaryHost"
                Grid.Column="2"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Left" />

        </Grid>
    </Border>

</UserControl>