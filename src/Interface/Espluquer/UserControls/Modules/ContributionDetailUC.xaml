<UserControl x:Class="Espluquer.UserControls.Modules.ContributionDetailUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Espluquer.UserControls.Modules"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModuleDiagnosticStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Expander Margin="0,0,0,8"
              Style="{StaticResource App.SectionExpander}"
              IsExpanded="False">

        <Expander.Header>

            <Grid VerticalAlignment="Center" Loaded="ContributionHeader_Loaded">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Contribution type + label -->
                <StackPanel x:Name="ContributionHeaderInfo"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center" />

                <!-- Active -->
                <ToggleButton Grid.Column="1"
                      Width="42"
                      Height="20"
                      Margin="8,0,8,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ContributionSettings.Active, Mode=TwoWay}"
                      Style="{StaticResource App.SwitchToggleButton}" 
                      Click="ActiveToggle_Click"/>

            </Grid>

        </Expander.Header>

        <Border Background="{DynamicResource App.Border}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                Padding="5,5,5,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <!-- ========================================================= -->
                <!-- CONTRIBUTION INFORMATION                                  -->
                <!-- ========================================================= -->

                <Border x:Name="ContributionInformationBlock"
                        Grid.Row="0"
                        Grid.Column="0"
                        Background="{DynamicResource App.Background}"
                        BorderThickness="1"
                        Padding="12">

                    <StackPanel>

                        <TextBlock Text="Contribution information"
                                   Style="{StaticResource App.StandardSubtitleTextBlock}"
                                   Foreground="{DynamicResource App.Accent}"
                                   Margin="0,0,0,10" />

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <!-- Label -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Label"
                                       Style="{StaticResource App.StandardTextBlock}"
                                       Margin="0,4,8,4"
                                       VerticalAlignment="Center" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="0,2"
                                     IsReadOnly="True"
                                     Text="{Binding Label}" />


                            <!-- Interface type -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Interface type"
                                       Style="{StaticResource App.StandardTextBlock}"
                                       Margin="0,4,8,4"
                                       VerticalAlignment="Center" />

                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,2"
                                     IsReadOnly="True"
                                     Text="{Binding InterfaceType}" />


                            <!-- Class name -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Class name"
                                       Style="{StaticResource App.StandardTextBlock}"
                                       Margin="0,4,8,4"
                                       VerticalAlignment="Center" />

                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Margin="0,2"
                                     IsReadOnly="True"
                                     Text="{Binding ClassName}" />


                            <!-- Description -->

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Description"
                                       Style="{StaticResource App.StandardTextBlock}"
                                       Margin="0,4,8,4"
                                       VerticalAlignment="Top" />

                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Margin="0,2"
                                     MinHeight="60"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding Description}" />

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ========================================================= -->
                <!-- CONTRIBUTION SETTINGS                                     -->
                <!-- ========================================================= -->

                <Border x:Name="ContributionSettingsBlock"
                    Grid.Row="0"
                    Grid.Column="2"
                    Background="{DynamicResource App.Background}"
                    BorderThickness="1"
                    Padding="12">

                    <StackPanel>

                        <TextBlock Text="Tags"
                           Style="{StaticResource App.StandardSubtitleTextBlock}"
                                   Foreground="{DynamicResource App.Accent}"
                           Margin="0,0,0,10" />

                        <!-- Existing tags -->

                        <ItemsControl ItemsSource="{Binding ContributionSettings.Tags}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Style="{StaticResource App.SubtleListRowBorder}">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                               Margin="4,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding}" />

                                            <Button Grid.Column="1"
                                                Style="{StaticResource App.FluentButtonClose}"
                                                FontSize="16"
                                                Content="&#xF34C;"
                                                Tag="{Binding DataContext,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Click="RemoveTagButton_Click" />

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>


                        <!-- Add concept -->

                        <Button x:Name="AddTagButton"
                            Style="{StaticResource Thesaurus.AddListItemButton}"
                            Content="&#xF109;"
                            Tag="{Binding}"
                            Click="AddTagButton_Click" />

                        <!-- Concept search -->

                        <ContentControl x:Name="ConceptSearchHost"
                            Margin="0,4,0,0"
                            Visibility="Collapsed" />

                    </StackPanel>

                </Border>
                
                <!-- ========================================================= -->
                <!-- CONTRIBUTION HEALTH                                       -->
                <!-- ========================================================= -->

                <Border x:Name="ContributionHealthBlock"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource App.Background}"
                        BorderThickness="1"
                        Padding="12">

                    <StackPanel>

                        <TextBlock Text="Health"
                                   Style="{StaticResource App.StandardSubtitleTextBlock}"
                                   Foreground="{DynamicResource App.Accent}"
                                   Margin="0,0,0,10" />

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <!-- Health check -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Health check"
                                       Style="{StaticResource App.StandardTextBlock}"
                                       Margin="0,4,8,4"
                                       VerticalAlignment="Center" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="0,2"
                                     IsReadOnly="True"
                                     Loaded="ContributionHealth_Loaded" />


                            <!-- Diagnostic -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Diagnostic"
                                       Style="{StaticResource App.StandardTextBlock}"
                                       Margin="0,8,8,4"
                                       VerticalAlignment="Top" />

                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,8,0,0"
                                     MinHeight="60"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     Loaded="ContributionError_Loaded">

                                <TextBox.Style>
                                    <Style TargetType="TextBox">

                                        <Style.Triggers>

                                            <Trigger Property="Text"
                                                     Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>

                                        </Style.Triggers>

                                    </Style>
                                </TextBox.Style>

                            </TextBox>

                        </Grid>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

    </Expander>

</UserControl>