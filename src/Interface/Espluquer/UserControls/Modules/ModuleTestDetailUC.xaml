<UserControl x:Class="Espluquer.UserControls.Modules.ModuleTestDetailUC"
             x:Name="ModuleDetailRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Espluquer.UserControls.Modules"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModuleDiagnosticStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.Background}">

        <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource App.Background}">

            <StackPanel Margin="8">

                <!-- Module -->

                <Expander Style="{StaticResource App.SectionExpander}"
                      IsExpanded="True"
                      Margin="0,0,0,8">

                    <Expander.Header>
                        <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                            <Ellipse Width="12"
                                 Height="12"
                                 Style="{StaticResource ModuleStatusEllipseStyle}"
                                 Fill="{Binding ModuleHealth.HealthBrush, ElementName=ModuleDetailRoot}"/>

                            <TextBlock Margin="8,0,0,0"
                                   Style="{StaticResource App.StandardSubtitleTextBlock}"
                                   Foreground="{DynamicResource App.TextInverse}"
                                   VerticalAlignment="Center"
                                   Text="{Binding Name}" />

                        </StackPanel>
                    </Expander.Header>

                    <Border Background="{DynamicResource App.Background}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1"
                        Padding="12">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Style="{StaticResource App.StandardTextBlock}"
                                   Margin="0,4,8,4"
                                   VerticalAlignment="Center"
                                   Text="Version" />

                            <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="0,2"
                                 IsReadOnly="True"
                                 Text="{Binding Version}" />

                            <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Style="{StaticResource App.StandardTextBlock}"
                               Margin="0,4,8,4"
                               VerticalAlignment="Center"
                               Text="Author" />

                            <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,2"
                             IsReadOnly="True"
                             Text="{Binding Author}" />

                            <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Style="{StaticResource App.StandardTextBlock}"
                           Margin="0,4,8,4"
                           VerticalAlignment="Top"
                           Text="Description" />

                            <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,2"
                             MinHeight="60"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Text="{Binding Description}" />

                            <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Style="{StaticResource App.StandardTextBlock}"
                                   Margin="0,4,8,4"
                                   VerticalAlignment="Center"
                                   Text="Assembly" />

                            <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="0,2"
                                 IsReadOnly="True"
                                 Text="{Binding Assembly}" />

                            <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Style="{StaticResource App.StandardTextBlock}"
                                   Margin="0,4,8,4"
                                   VerticalAlignment="Center"
                                   Text="File path" />

                            <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="0,2"
                                 IsReadOnly="True"
                                 Text="{Binding FilePath}" />

                        </Grid>

                    </Border>

                </Expander>

                <!-- JSON -->

                <Expander Header="JSON" Style="{StaticResource App.SectionExpander}" IsExpanded="False" Margin="0,0,0,8">

                    <Border Background="{DynamicResource App.Background}"
                    BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="1"
                    Padding="8">

                        <TextBox x:Name="JsonTextBox" Style="{StaticResource App.TextEditorTextBox}" />

                    </Border>

                </Expander>

                <!-- Contributions -->

                <ItemsControl ItemsSource="{Binding Contributions}" HorizontalContentAlignment="Stretch">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ContributionDetailUC
                                ModuleInfo="{Binding ModuleInfo, RelativeSource={RelativeSource AncestorType={x:Type local:ModuleTestDetailUC}}}"
                                ContributionHealths="{Binding ContributionHealths, RelativeSource={RelativeSource AncestorType={x:Type local:ModuleTestDetailUC}}}"
                                ConceptSearch="{Binding ConceptSearch, RelativeSource={RelativeSource AncestorType={x:Type local:ModuleTestDetailUC}}}" 
                                SettingsChanged="ContributionDetail_SettingsChanged" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>
    </Grid>

</UserControl>