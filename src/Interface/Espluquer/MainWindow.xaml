<Window x:Class="Espluquer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Espluquer"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Espluquer"
        Height="800"
        Width="1200"
        AllowDrop="True"
        AllowsTransparency="False"
        Background="{DynamicResource App.Background}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="40"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="20"
            UseAeroCaptionButtons="True" />
    </shell:WindowChrome.WindowChrome>

    <Grid Style="{StaticResource App.WindowLayout}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="8*" MinHeight="50"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="3*" MinHeight="50"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->

        <Grid Grid.Row="0" Style="{StaticResource App.TopBar}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="MenuButton"
                        Style="{StaticResource App.FluentButton}"
                        Margin="5,0,0,0"
                        Content="&#xF561;"
                        Click="MenuButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button.ContextMenu>
                        <ContextMenu x:Name="MainMenu" StaysOpen="False">
                            <MenuItem Header="Open file" Tag="OpenFile" Click="MainMenuItem_Click" />
                            <MenuItem x:Name="RecentFilesMenu" Header="Recent files" />
                            <Separator />

                            <MenuItem Header="Parameters">
                                <MenuItem Header="Pronom / DROID" Tag="Parameters.PronomDroid" Click="MainMenuItem_Click" />
                                <MenuItem Header="Thesaurus" Tag="Parameters.Thesaurus" Click="MainMenuItem_Click" />
                            </MenuItem>

                            <MenuItem Header="Modules">
                                <MenuItem Header="Diagnostics" Tag="Modules.Diagnostics" Click="MainMenuItem_Click" />
                                <MenuItem Header="Log catalog" Tag="Modules.LogCatalog" Click="MainMenuItem_Click" />
                            </MenuItem>

                            <Separator />
                            <MenuItem Header="Exit" Tag="Exit" Click="MainMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <TextBlock Text="Espluquer" Style="{StaticResource App.StandardSubtitleTextBlock}" />
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Column="1" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Quick menu -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button x:Name="ThemeButton"
                            Style="{StaticResource App.FluentButton}"
                            Content="&#xE700;"
                            Click="ThemeButton_Click"/>
                </StackPanel>

                <!-- Window buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="0,0,5,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button Content="&#xEBCF;"
                            Style="{StaticResource App.FluentButton}"
                            Click="MinimizeButton_Click" />

                    <Button x:Name="MaximizeButton"
                            Content="&#xF533;"
                            Style="{StaticResource App.FluentButton}"
                            Click="MaximizeButton_Click" />

                    <Button Style="{StaticResource App.FluentButtonClose}"
                            Content="&#xF368;"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Application content -->
        <Grid Grid.Row="1">

            <ContentControl x:Name="MainContentHost">
                <TabControl x:Name="MainTabs"
                    Style="{StaticResource App.Controls.TabControl}"
                    Visibility="Collapsed" />
            </ContentControl>

            <TextBlock Text="&lt; Drop file here ! &gt;"
               IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.DropMessageText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count, ElementName=MainTabs}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </Grid>

        <GridSplitter Grid.Row="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{DynamicResource App.Border}"
              ShowsPreview="True"
              ResizeDirection="Rows" />
        
        <!-- Log zone -->
        <ContentControl x:Name="InfoHost" Grid.Row="3"/>

        <Border Grid.Row="4" Style="{StaticResource App.StatusBar}">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Style="{StaticResource App.StandardTextBlock}" 
                           Visibility="Hidden"/>

                <TextBlock x:Name="InfoText"
                           Text="No file loaded"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Opacity="0.65"
                           Style="{StaticResource App.StandardTextBlock}" 
                           Visibility="Collapsed"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>