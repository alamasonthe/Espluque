<Application x:Class="Espluquer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Espluquer">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Espluque.Theming;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Espluque.Theming;component/Styles/Styles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Espluque.Theming;component/Fonts/Fonts.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
