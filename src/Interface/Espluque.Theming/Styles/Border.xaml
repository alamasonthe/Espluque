<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="App.StatusBar" TargetType="Border">
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style x:Key="App.SectionBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="App.SubtleListRowBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,2,0,3" />
    </Style>

</ResourceDictionary>