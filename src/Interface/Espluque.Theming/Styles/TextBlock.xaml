<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="App.TextBlock" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="App.StandardTitleTextBlock" TargetType="TextBlock"
        BasedOn="{StaticResource App.TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="App.MutedTitleTextBlock" TargetType="TextBlock"
        BasedOn="{StaticResource App.TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="App.StandardSubtitleTextBlock" TargetType="TextBlock"
    BasedOn="{StaticResource App.TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="App.MutedSubtitleTextBlock" TargetType="TextBlock"
    BasedOn="{StaticResource App.TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="App.StandardTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="App.MutedTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="App.SectionLabelText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="25" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextInverse}" />
        <Setter Property="Background" Value="{DynamicResource App.Border}" />
        <Setter Property="Padding" Value="5,0,0,0" />
    </Style>

    <!-- Specific -->

    <Style x:Key="App.DropMessageText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Thesaurus.PreferredTermStarText" TargetType="{x:Type TextBlock}">
        <Setter Property="Text" Value="&#xF713;" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentIcons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPreferred}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>